DATABASE_URL="file:./prisma/dev.db"
SESSION_COOKIE_NAME="collab_session"

# Optional STUN override (defaults to Google STUN in code if unset)
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302"

# TURN (recommended for reliable calls)
WEBRTC_TURN_URLS="turn:localhost:3478,turns:localhost:5349?transport=tcp"
WEBRTC_TURN_USERNAME="localturn"
WEBRTC_TURN_CREDENTIAL="localturnpass"

# Local transcription backend
TRANSCRIPTION_PROVIDER="faster-whisper"
FASTER_WHISPER_MODEL="small"
FASTER_WHISPER_DEVICE="auto"
FASTER_WHISPER_COMPUTE_TYPE="int8"

# Meeting report generation
MEETING_REPORT_PROVIDER="heuristic"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_REPORT_MODEL="qwen2.5:3b"
