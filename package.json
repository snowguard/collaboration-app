    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "prisma": "6.19.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
